- var htmlClassHideAside = theme.aside.enable && theme.aside.hide ? 'hide-aside' : ''
- var hideAside = !theme.aside.enable || page.aside === false ? 'hide-aside' : ''
- var pageType = is_post() ? 'post' : 'page'

doctype html
html(lang=config.language data-theme=theme.display_mode class=htmlClassHideAside)
  head
    include ./head.pug
  body
    if theme.preloader
      !=partial('includes/loading/loading', {}, {cache: true})

    // 海洋背景层
    #ocean-bg
      .ocean-gradient
      .ocean-glow
      svg.ocean-waves(viewBox="0 0 1440 320" preserveAspectRatio="none")
        path.wave-1(d="M0,192L48,186.7C96,181,192,171,288,181.3C384,192,480,224,576,218.7C672,213,768,171,864,165.3C960,160,1056,192,1152,197.3C1248,203,1344,181,1392,170.7L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z")
        path.wave-2(d="M0,256L48,261.3C96,267,192,277,288,272C384,267,480,245,576,229.3C672,213,768,203,864,208C960,213,1056,235,1152,234.7C1248,235,1344,213,1392,202.7L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z")
        path.wave-3(d="M0,288L48,282.7C96,277,192,267,288,261.3C384,256,480,256,576,261.3C672,267,768,277,864,277.3C960,277,1056,267,1152,256C1248,245,1344,235,1392,229.3L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z")
      .ocean-decor
        svg.sailboat(viewBox="0 0 64 64" width="40" height="40")
          path(d="M32 8 L32 40 L16 40 Z" fill="rgba(78,166,255,0.25)")
          path(d="M32 8 L32 40 L48 40 Z" fill="rgba(78,166,255,0.18)")
          path(d="M12 42 L52 42 L48 48 L16 48 Z" fill="rgba(78,166,255,0.22)")
        svg.seagull(viewBox="0 0 40 20" width="28" height="14")
          path(d="M0 10 Q10 2 20 10 Q30 2 40 10" fill="none" stroke="rgba(78,166,255,0.2)" stroke-width="1.5")
        svg.seagull.seagull-2(viewBox="0 0 40 20" width="22" height="11")
          path(d="M0 10 Q10 2 20 10 Q30 2 40 10" fill="none" stroke="rgba(78,166,255,0.15)" stroke-width="1.2")

    !=partial('includes/sidebar', {}, {cache: true})

    if page.type !== '404'
      #body-wrap(class=pageType)
        include ./header/index.pug

        main#content-inner.layout(class=hideAside)
          .main-content-column
            if is_home()
              #hero-section
                .hero-title
                  = config.title
                  span.hero-wave ～
                .hero-subtitle= theme.aside.card_author.description || config.subtitle
                .hero-meta
                  span
                    i.fas.fa-map-marker-alt
                    | 中国·重庆
                  span.hero-divider ·
                  span
                    i.far.fa-clock
                    | 最后更新：
                    span#hero-last-update(data-lastPushDate=date_xml(Date.now()))
                  if theme.runtimeshow.enable
                    span
                      i.fas.fa-stopwatch
                      | 已运行：
                      span#hero-runtime(data-publishDate=date_xml(theme.runtimeshow.publish_date))

            if body
              div!= body
            else
              block content
          if theme.aside.enable && page.aside !== false
            include widget/index.pug

        footer#footer.ocean-footer
          .footer-wave
            svg(viewBox="0 0 1440 120" preserveAspectRatio="none")
              path(d="M0,40L60,45C120,50,240,60,360,58C480,56,600,42,720,38C840,34,960,40,1080,48C1200,56,1320,66,1380,70L1440,74L1440,120L0,120Z" fill="rgba(78,166,255,0.08)")
          #footer-wrap
            !=partial('includes/footer', {}, {cache: true})

    else
      include ./404.pug

    include ./rightside.pug
    !=partial('includes/third-party/search/index', {}, {cache: true})
    include ./additional-js.pug
