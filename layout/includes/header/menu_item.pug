if theme.menu
  .menus_items
    each value, label in theme.menu
      if typeof value !== 'object'
        .menus_item.island-item
          - const valueArray = value.split('||')
          - const menuUrl = trim(valueArray[0])
          - let isCurrent = false
          - if (menuUrl === '/') { isCurrent = is_home() } else { isCurrent = page.path && url_for(page.path).startsWith(url_for(menuUrl)) }
          a.site-page(href=url_for(menuUrl) class=isCurrent ? 'active' : '')
            if valueArray[1]
              i(class=trim(valueArray[1]))
            span=' '+label
      else
        each val, lab in value
          - const valArray = val.split('||')
          - const menuUrl = trim(valArray[0])
          - let isCurrent = false
          - if (menuUrl === '/') { isCurrent = is_home() } else { isCurrent = page.path && url_for(page.path).startsWith(url_for(menuUrl)) }
          .menus_item.island-item
            a.site-page(href=url_for(menuUrl) class=isCurrent ? 'active' : '')
              if valArray[1]
                i(class=trim(valArray[1]))
              span=' '+ lab
